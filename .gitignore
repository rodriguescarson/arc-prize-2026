# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# datasets are cloned, not committed
data/*
# the packed replay store is derived, 14 MB, and is what E21 actually reads: keeping it in the
# repo means the experiment runs from a bare clone instead of a 453 MB download plus a repack.
# (data/* not data/, because git does not descend into an excluded directory to find a negation.)
!data/human_replays_packed/
# secrets
.env
.env.*
!.env.example
# experiment artefacts that are large
experiments/**/predictions*.json
